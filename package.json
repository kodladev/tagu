{
  "name": "tagu",
  "version": "0.1.0",
  "description": "A small HTML parser that understands template syntax",
  "keywords": [
    "html",
    "parser",
    "ast",
    "template",
    "tiny"
  ],
  "bugs": {
    "url": "https://github.com/kodladev/tagu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodladev/tagu.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kodla",
    "email": "info@kodla.net",
    "url": "https://kodla.net"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./type/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./type/index.d.ts",
  "files": [
    "src",
    "type"
  ],
  "scripts": {
    "bench": "vitest bench",
    "bench:compare": "node bench/compare.js",
    "bench:fetch": "node bench/fetch.js",
    "bench:memory": "node bench/memory.js",
    "bench:reads": "node bench/reads.js",
    "bench:size": "node bench/size.js",
    "bench:table": "node bench/table.js",
    "prebuild": "rimraf type",
    "build": "node build",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "dependencies": {
    "uty": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lukeed/html": "^1.0.2",
    "dts-buddy": "^0.8.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "himalaya": "^1.1.1",
    "htmlparser2": "^12.0.0",
    "node-html-parser": "^9.0.7",
    "parse5": "^8.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "ultrahtml": "^1.7.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  }
}
